
@page "/compras"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop

@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Compras</PageTitle>

<h3>Gestión de Compras</h3>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")" role="alert">
        @mensaje
    </div>
}

<div class="card p-3 mb-4">
    <h5>@(compraEditando == 0 ? "Registrar compra" : $"Editar compra #{compraEditando}")</h5>

    <div class="mb-3">
        <label class="form-label">Proveedor</label>
        <select class="form-select" @bind="idProveedor">
            <option value="0">Seleccione un proveedor</option>
            @foreach (var proveedor in proveedores)
            {
                <option value="@proveedor.Id_proveedor">
                    @NombreProveedor(proveedor)
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha y hora</label>
        <input type="datetime-local"
               class="form-control"
               @bind="fechaTexto" />
    </div>

    <button type="button"
            class="btn btn-primary"
            disabled="@procesando"
            @onclick="GuardarCompra">
        @(procesando ? "Procesando..." :
            compraEditando == 0 ? "Registrar compra" : "Guardar cambios")
    </button>

    @if (compraEditando != 0)
    {
        <button type="button"
                class="btn btn-secondary ms-2"
                disabled="@procesando"
                @onclick="CancelarEdicion">
            Cancelar edición
        </button>
    }
</div>

<div class="card p-3 mb-4">
    <h5>Agregar productos a una compra</h5>

    <div class="mb-3">
        <label class="form-label">Compra registrada</label>
        <select class="form-select" @bind="idCompraDetalle">
            <option value="0">Seleccione una compra</option>
            @foreach (var compra in compras)
            {
                <option value="@compra.Id_compra">
                    Compra #@compra.Id_compra -
                    @NombreProveedorPorId(compra.Id_proveedor)
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Producto</label>
        <select class="form-select" @bind="idProducto">
            <option value="0">Seleccione un producto</option>
            @foreach (var producto in productos)
            {
                <option value="@producto.Id_producto">
                    @producto.Nombre — Q @producto.Precio.ToString("N2")
                    (Existencia: @producto.Existencia)
                </option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">Cantidad</label>
        <input type="number"
               class="form-control"
               min="1"
               @bind="cantidad"
               @bind:event="oninput" />
    </div>

    <div class="mb-3">
        <label class="form-label">Precio unitario (Q)</label>
        <input type="number"
               class="form-control"
               min="0"
               step="0.01"
               @bind="precio"
               @bind:event="oninput" />
    </div>

    <div class="mb-3">
        <label class="form-label">Subtotal</label>
        <input class="form-control"
               value="@SubtotalCalculado.ToString("N2")"
               readonly />
    </div>

    <button type="button"
            class="btn btn-success"
            disabled="@procesando"
            @onclick="AgregarDetalle">
        Agregar producto
    </button>
</div>

<h5>Compras registradas</h5>

@if (cargando)
{
    <p>Cargando compras...</p>
}

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Proveedor</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (compras.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center">
                        No hay compras registradas.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var compra in compras)
                {
                    <tr @key="compra.Id_compra">
                        <td>@compra.Id_compra</td>
                        <td>@NombreProveedorPorId(compra.Id_proveedor)</td>
                        <td>@compra.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>Q @compra.Total.ToString("N2")</td>
                        <td>
                            <button type="button"
                                    class="btn btn-warning btn-sm"
                                    disabled="@procesando"
                                    @onclick="() => EditarCompra(compra)">
                                Editar
                            </button>

                            <button type="button"
                                    class="btn btn-success btn-sm ms-1"
                                    disabled="@procesando"
                                    @onclick="() => GenerarFacturaCompra(compra)">
                                Factura PDF
                            </button>

                            <button type="button"
                                    class="btn btn-danger btn-sm ms-1"
                                    disabled="@procesando"
                                    @onclick="() => EliminarCompra(compra.Id_compra)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<h5>Detalles de la compra seleccionada</h5>

<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>ID detalle</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio</th>
                <th>Subtotal</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (idCompraDetalle <= 0)
            {
                <tr>
                    <td colspan="6" class="text-center">
                        Seleccione una compra para ver sus detalles.
                    </td>
                </tr>
            }
            else if (detallesFiltrados.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">
                        Esta compra no tiene detalles.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var detalle in detallesFiltrados)
                {
                    <tr @key="detalle.Id_detalle">
                        <td>@detalle.Id_detalle</td>
                        <td>@NombreProductoPorId(detalle.Id_producto)</td>
                        <td>@detalle.Cantidad</td>
                        <td>Q @detalle.Precio.ToString("N2")</td>
                        <td>Q @detalle.Subtotal.ToString("N2")</td>
                        <td>
                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    disabled="@procesando"
                                    @onclick="() => EliminarDetalle(detalle.Id_detalle)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Total de la compra:</th>
                <th colspan="2">Q @TotalDetalleSeleccionado.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>
</div>

@code {
    private readonly JsonSerializerOptions opcionesJson =
        new() { PropertyNameCaseInsensitive = true };

    private List<Compra> compras = new();
    private List<Proveedor> proveedores = new();
    private List<Producto> productos = new();
    private List<DetalleCompra> detalles = new();

    private int idProveedor;
    private int compraEditando;
    private int idCompraDetalle;
    private int idProducto;
    private int cantidad = 1;

    private decimal precio;
    private DateTime fechaTexto = DateTime.Now;

    private string mensaje = "";
    private bool esError;
    private bool cargando;
    private bool procesando;

    private decimal SubtotalCalculado =>
        cantidad > 0 && precio >= 0 ? cantidad * precio : 0;

    private List<DetalleCompra> detallesFiltrados =>
        detalles.Where(d => d.Id_compra == idCompraDetalle).ToList();

    private decimal TotalDetalleSeleccionado =>
        detallesFiltrados.Sum(d => d.Subtotal);

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private HttpClient CrearCliente()
    {
        return HttpClientFactory.CreateClient("ApiEmpresa");
    }

    private async Task CargarDatos()
    {
        if (cargando)
            return;

        cargando = true;

        try
        {
            var api = CrearCliente();

            proveedores = await api.GetFromJsonAsync<List<Proveedor>>(
                "api/Proveedores", opcionesJson) ?? new();

            compras = await api.GetFromJsonAsync<List<Compra>>(
                "api/Compras", opcionesJson) ?? new();

            productos = await api.GetFromJsonAsync<List<Producto>>(
                "api/Productos", opcionesJson) ?? new();

            detalles = await api.GetFromJsonAsync<List<DetalleCompra>>(
                "api/Compras_detalle", opcionesJson) ?? new();
        }
        catch (Exception ex)
        {
            MostrarError("Error al cargar los datos: " + ex.Message);
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarCompra()
    {
        if (procesando)
            return;

        if (idProveedor <= 0)
        {
            MostrarError("Seleccione un proveedor.");
            return;
        }

        procesando = true;

        try
        {
            var api = CrearCliente();

            var compra = new Compra
            {
                Id_compra = compraEditando,
                Id_proveedor = idProveedor,
                Fecha = fechaTexto,
                Total = compras.FirstOrDefault(
                    c => c.Id_compra == compraEditando)?.Total ?? 0
            };

            HttpResponseMessage respuesta;

            if (compraEditando == 0)
            {
                compra.Total = 0;
                respuesta = await api.PostAsJsonAsync("api/Compras", compra);
            }
            else
            {
                respuesta = await api.PutAsJsonAsync(
                    $"api/Compras/{compraEditando}", compra);
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                MostrarError(
                    $"La API rechazó la operación ({(int)respuesta.StatusCode}): {error}");
                return;
            }

            var eraEdicion = compraEditando != 0;

            LimpiarFormulario();
            await CargarDatos();

            mensaje = eraEdicion
                ? "Compra actualizada correctamente."
                : "Compra registrada correctamente.";

            esError = false;
        }
        catch (Exception ex)
        {
            MostrarError("Error al guardar la compra: " + ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task AgregarDetalle()
    {
        if (procesando)
            return;

        if (idCompraDetalle <= 0)
        {
            MostrarError("Seleccione una compra registrada.");
            return;
        }

        if (idProducto <= 0)
        {
            MostrarError("Seleccione un producto.");
            return;
        }

        if (cantidad <= 0)
        {
            MostrarError("La cantidad debe ser mayor que cero.");
            return;
        }

        if (precio < 0)
        {
            MostrarError("El precio no puede ser negativo.");
            return;
        }

        var productoSeleccionado = productos.FirstOrDefault(
            p => p.Id_producto == idProducto);

        if (productoSeleccionado == null)
        {
            MostrarError("El producto seleccionado no existe.");
            return;
        }

        procesando = true;

        try
        {
            var api = CrearCliente();

            var nuevoDetalle = new DetalleCompra
            {
                Id_compra = idCompraDetalle,
                Id_producto = idProducto,
                Cantidad = cantidad,
                Precio = precio,
                Subtotal = SubtotalCalculado
            };

            var respuesta = await api.PostAsJsonAsync(
                "api/Compras_detalle", nuevoDetalle);

            if (!respuesta.IsSuccessStatusCode)
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                MostrarError(
                    $"La API rechazó el detalle ({(int)respuesta.StatusCode}): {error}");
                return;
            }

            idProducto = 0;
            cantidad = 1;
            precio = 0;

            await CargarDatos();

            mensaje = "Producto agregado a la compra correctamente.";
            esError = false;
        }
        catch (Exception ex)
        {
            MostrarError("Error al agregar el producto: " + ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }

    private void EditarCompra(Compra compra)
    {
        compraEditando = compra.Id_compra;
        idProveedor = compra.Id_proveedor;
        fechaTexto = compra.Fecha;

        mensaje = $"Editando compra #{compra.Id_compra}. Modifique los datos y pulse Guardar cambios.";
        esError = false;
    }

    private void CancelarEdicion()
    {
        LimpiarFormulario();
        mensaje = "Edición cancelada.";
        esError = false;
    }

    private async Task GenerarFacturaCompra(Compra compra)
    {
        try
        {
            var detallesCompra = detalles
                .Where(d => d.Id_compra == compra.Id_compra)
                .ToList();

            if (detallesCompra.Count == 0)
            {
                MostrarError(
                    $"La compra #{compra.Id_compra} no tiene productos. Agregue productos antes de generar la factura.");
                return;
            }

            var factura = new
            {
                numero = $"COMP-{compra.Id_compra:D6}",
                fecha = compra.Fecha.ToString("dd/MM/yyyy HH:mm"),
                proveedor = NombreProveedorPorId(compra.Id_proveedor),
                items = detallesCompra.Select(d => new
                {
                    producto = NombreProductoPorId(d.Id_producto),
                    cantidad = d.Cantidad,
                    precio = d.Precio,
                    subtotal = d.Subtotal
                }).ToList(),
                total = detallesCompra.Sum(d => d.Subtotal)
            };

            await JS.InvokeVoidAsync(
                "aresFacturas.imprimirCompra",
                factura);

            mensaje =
                $"Factura de compra #{compra.Id_compra} preparada para imprimir o guardar como PDF.";

            esError = false;
        }
        catch (JSException ex)
        {
            MostrarError(
                "No se pudo abrir la factura. Compruebe que " +
                "wwwroot/js/facturas.js esté cargado. Detalle: " +
                ex.Message);
        }
        catch (Exception ex)
        {
            MostrarError("Error al generar la factura: " + ex.Message);
        }
    }

    private async Task EliminarCompra(int id)
    {
        if (procesando)
            return;

        procesando = true;

        try
        {
            var api = CrearCliente();
            var respuesta = await api.DeleteAsync($"api/Compras/{id}");

            if (!respuesta.IsSuccessStatusCode)
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                MostrarError(
                    $"No se pudo eliminar la compra ({(int)respuesta.StatusCode}): {error}");
                return;
            }

            if (compraEditando == id)
                LimpiarFormulario();

            if (idCompraDetalle == id)
                idCompraDetalle = 0;

            await CargarDatos();

            mensaje = $"Compra #{id} eliminada correctamente.";
            esError = false;
        }
        catch (Exception ex)
        {
            MostrarError("Error al eliminar la compra: " + ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }

    private async Task EliminarDetalle(int id)
    {
        if (procesando)
            return;

        procesando = true;

        try
        {
            var api = CrearCliente();
            var respuesta = await api.DeleteAsync(
                $"api/Compras_detalle/{id}");

            if (!respuesta.IsSuccessStatusCode)
            {
                var error = await respuesta.Content.ReadAsStringAsync();
                MostrarError(
                    $"No se pudo eliminar el detalle ({(int)respuesta.StatusCode}): {error}");
                return;
            }

            await CargarDatos();

            mensaje = "Detalle eliminado correctamente.";
            esError = false;
        }
        catch (Exception ex)
        {
            MostrarError("Error al eliminar el detalle: " + ex.Message);
        }
        finally
        {
            procesando = false;
        }
    }

    private string NombreProveedor(Proveedor proveedor)
    {
        if (!string.IsNullOrWhiteSpace(proveedor.NombreProveedor))
            return proveedor.NombreProveedor;

        if (!string.IsNullOrWhiteSpace(proveedor.Nombre))
            return proveedor.Nombre;

        if (!string.IsNullOrWhiteSpace(proveedor.RazonSocial))
            return proveedor.RazonSocial;

        return $"Proveedor {proveedor.Id_proveedor}";
    }

    private string NombreProveedorPorId(int id)
    {
        var proveedor = proveedores.FirstOrDefault(
            p => p.Id_proveedor == id);

        return proveedor == null
            ? $"Proveedor {id}"
            : NombreProveedor(proveedor);
    }

    private string NombreProductoPorId(int id)
    {
        return productos.FirstOrDefault(
            p => p.Id_producto == id)?.Nombre ?? $"Producto {id}";
    }

    private void LimpiarFormulario()
    {
        compraEditando = 0;
        idProveedor = 0;
        fechaTexto = DateTime.Now;
    }

    private void MostrarError(string texto)
    {
        mensaje = texto;
        esError = true;
    }

    public class Compra
    {
        public int Id_compra { get; set; }
        public int Id_proveedor { get; set; }
        public DateTime Fecha { get; set; }
        public decimal Total { get; set; }
    }

    public class Proveedor
    {
        public int Id_proveedor { get; set; }
        public string NombreProveedor { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string RazonSocial { get; set; } = "";
    }

    public class Producto
    {
        public int Id_producto { get; set; }
        public string Codigo { get; set; } = "";
        public string Nombre { get; set; } = "";
        public decimal Precio { get; set; }
        public int Existencia { get; set; }
    }

    public class DetalleCompra
    {
        public int Id_detalle { get; set; }
        public int Id_compra { get; set; }
        public int Id_producto { get; set; }
        public int Cantidad { get; set; }
        public decimal Precio { get; set; }
        public decimal Subtotal { get; set; }
    }
}
