
@page "/empleado"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Empleados</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Empleados</h1>

        <button class="btn btn-primary" @onclick="NuevoEmpleado">
            Nuevo empleado
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert @claseMensaje alert-dismissible fade show">
            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="LimpiarMensaje">
            </button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center mt-4">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2">Cargando empleados...</p>
        </div>
    }
    else if (empleados.Count == 0)
    {
        <div class="alert alert-info">
            No hay empleados registrados.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Código</th>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Fecha de nacimiento</th>
                        <th>Estado</th>
                        <th>Fecha de ingreso</th>
                        <th>ID del puesto</th>
                        <th>Sueldo</th>
                        <th>Bonificación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var empleado in empleados)
                    {
                        <tr>
                            <td>@empleado.idempleados</td>
                            <td>@empleado.Codigo</td>
                            <td>@empleado.nombres</td>
                            <td>@empleado.apellidos</td>
                            <td>@empleado.direccion</td>
                            <td>@empleado.telefono</td>
                            <td>@empleado.fecha_nacimiento?.ToString("dd/MM/yyyy")</td>
                            <td>@empleado.activo</td>
                            <td>@empleado.fecha_ingreso.ToString("dd/MM/yyyy")</td>
                            <td>@empleado.id_puesto</td>
                            <td>@empleado.Sueldo?.ToString("0.00")</td>
                            <td>@empleado.Bonificacion?.ToString("0.00")</td>

                            <td>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-warning btn-sm"
                                            @onclick="() => EditarEmpleado(empleado)">
                                        Editar
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => ConfirmarEliminar(empleado)">
                                        Eliminar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@if (mostrarFormulario)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(modoEdicion ? "Editar empleado" : "Nuevo empleado")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarFormulario">
                    </button>
                </div>

                <EditForm EditContext="@editContext"
                          OnValidSubmit="GuardarEmpleado">

                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="modal-body">
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Código</label>
                                <InputText class="form-control"
                                           @bind-Value="formulario.Codigo" />
                                <ValidationMessage For="@(() => formulario.Codigo)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Nombres</label>
                                <InputText class="form-control"
                                           @bind-Value="formulario.nombres" />
                                <ValidationMessage For="@(() => formulario.nombres)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Apellidos</label>
                                <InputText class="form-control"
                                           @bind-Value="formulario.apellidos" />
                                <ValidationMessage For="@(() => formulario.apellidos)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Teléfono</label>
                                <InputText class="form-control"
                                           @bind-Value="formulario.telefono" />
                                <ValidationMessage For="@(() => formulario.telefono)" />
                            </div>

                            <div class="col-md-12 mb-3">
                                <label class="form-label">Dirección</label>
                                <InputText class="form-control"
                                           @bind-Value="formulario.direccion" />
                                <ValidationMessage For="@(() => formulario.direccion)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de nacimiento</label>
                                <InputDate TValue="DateTime?"
                                           class="form-control"
                                           @bind-Value="formulario.fecha_nacimiento" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Fecha de ingreso</label>
                                <InputDate TValue="DateTime"
                                           class="form-control"
                                           @bind-Value="formulario.fecha_ingreso" />
                                <ValidationMessage For="@(() => formulario.fecha_ingreso)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Estado</label>
                                <InputSelect class="form-select"
                                             @bind-Value="formulario.activo">
                                    <option value="">Seleccione un estado</option>
                                    <option value="Activo">Activo</option>
                                    <option value="Inactivo">Inactivo</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => formulario.activo)" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Puesto</label>

                                <InputSelect TValue="int"
                                             class="form-select"
                                             @bind-Value="formulario.id_puesto">

                                    <option value="0">Seleccione un puesto</option>

                                    @foreach (var puesto in puestos)
                                    {
                                        <option value="@puesto.Id_puesto">
                                            @puesto.Nombre_puesto
                                        </option>
                                    }
                                </InputSelect>

                                <ValidationMessage For="@(() => formulario.id_puesto)" />

                                @if (cargandoPuestos)
                                {
                                    <small class="text-muted">
                                        Cargando puestos...
                                    </small>
                                }
                                else if (puestos.Count == 0)
                                {
                                    <small class="text-danger">
                                        No hay puestos disponibles. Compruebe la API.
                                    </small>
                                }
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Sueldo</label>
                                <InputNumber TValue="decimal?"
                                             class="form-control"
                                             @bind-Value="formulario.Sueldo" />
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label">Bonificación</label>
                                <InputNumber TValue="decimal?"
                                             class="form-control"
                                             @bind-Value="formulario.Bonificacion" />
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CerrarFormulario">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@guardando">

                            @(guardando
                                ? "Guardando..."
                                : modoEdicion
                                    ? "Guardar cambios"
                                    : "Registrar empleado")
                        </button>
                    </div>

                </EditForm>
            </div>
        </div>
    </div>
}

@if (mostrarConfirmacion)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Eliminar empleado</h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CancelarEliminar">
                    </button>
                </div>

                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar al empleado
                    <strong>@empleadoSeleccionado?.nombres
                        @empleadoSeleccionado?.apellidos</strong>?
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            @onclick="CancelarEliminar">
                        Cancelar
                    </button>

                    <button class="btn btn-danger"
                            @onclick="EliminarEmpleado"
                            disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Sí, eliminar")
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private HttpClient Api =>
        HttpClientFactory.CreateClient("ApiEmpresa");

    private List<EmpleadoModel> empleados = new();
    private List<PuestoModel> puestos = new();

    private EmpleadoModel formulario = new();
    private EmpleadoModel? empleadoSeleccionado;
    private EditContext editContext = default!;

    private bool cargando = true;
    private bool cargandoPuestos;
    private bool mostrarFormulario;
    private bool mostrarConfirmacion;
    private bool guardando;
    private bool eliminando;
    private bool modoEdicion;

    private string mensaje = "";
    private string claseMensaje = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
        await CargarEmpleados();
    }

    private async Task CargarPuestos()
    {
        try
        {
            cargandoPuestos = true;

            puestos = await Api.GetFromJsonAsync<List<PuestoModel>>(
                "api/Puestos") ?? new List<PuestoModel>();
        }
        catch (Exception ex)
        {
            puestos = new List<PuestoModel>();

            MostrarMensaje(
                "Error al cargar puestos: " + ex.Message,
                "alert-danger");
        }
        finally
        {
            cargandoPuestos = false;
        }
    }

    private async Task CargarEmpleados()
    {
        try
        {
            cargando = true;

            empleados = await Api.GetFromJsonAsync<List<EmpleadoModel>>(
                "api/Empleados") ?? new List<EmpleadoModel>();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                "Error al cargar empleados: " + ex.Message,
                "alert-danger");
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoEmpleado()
    {
        formulario = new EmpleadoModel
        {
            fecha_ingreso = DateTime.Today,
            activo = "Activo",
            id_puesto = 0
        };

        modoEdicion = false;
        editContext = new EditContext(formulario);

        mostrarFormulario = true;
        LimpiarMensaje();
    }

    private void EditarEmpleado(EmpleadoModel empleado)
    {
        formulario = new EmpleadoModel
        {
            idempleados = empleado.idempleados,
            Codigo = empleado.Codigo,
            nombres = empleado.nombres,
            apellidos = empleado.apellidos,
            direccion = empleado.direccion,
            telefono = empleado.telefono,
            fecha_nacimiento = empleado.fecha_nacimiento,
            activo = empleado.activo,
            fecha_ingreso = empleado.fecha_ingreso,
            id_puesto = empleado.id_puesto,
            Sueldo = empleado.Sueldo,
            Bonificacion = empleado.Bonificacion
        };

        modoEdicion = true;
        editContext = new EditContext(formulario);

        mostrarFormulario = true;
        LimpiarMensaje();
    }

    private async Task GuardarEmpleado()
    {
        if (guardando)
            return;

        if (formulario.id_puesto <= 0 ||
            !puestos.Any(p => p.Id_puesto == formulario.id_puesto))
        {
            MostrarMensaje(
                "Seleccione un puesto válido antes de guardar.",
                "alert-danger");
            return;
        }

        try
        {
            guardando = true;

            HttpResponseMessage respuesta;

            if (modoEdicion)
            {
                respuesta = await Api.PutAsJsonAsync(
                    $"api/Empleados/{formulario.idempleados}",
                    formulario);
            }
            else
            {
                respuesta = await Api.PostAsJsonAsync(
                    "api/Empleados",
                    formulario);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                bool eraEdicion = modoEdicion;

                CerrarFormulario();
                await CargarEmpleados();

                MostrarMensaje(
                    eraEdicion
                        ? "Empleado actualizado correctamente."
                        : "Empleado registrado correctamente.",
                    "alert-success");
            }
            else
            {
                string detalle = await respuesta.Content.ReadAsStringAsync();

                MostrarMensaje(
                    "No se pudo guardar el empleado. " + detalle,
                    "alert-danger");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                "Error al guardar el empleado: " + ex.Message,
                "alert-danger");
        }
        finally
        {
            guardando = false;
        }
    }

    private void ConfirmarEliminar(EmpleadoModel empleado)
    {
        empleadoSeleccionado = empleado;
        mostrarConfirmacion = true;
        LimpiarMensaje();
    }

    private async Task EliminarEmpleado()
    {
        if (empleadoSeleccionado == null || eliminando)
            return;

        try
        {
            eliminando = true;

            var respuesta = await Api.DeleteAsync(
                $"api/Empleados/{empleadoSeleccionado.idempleados}");

            if (respuesta.IsSuccessStatusCode)
            {
                mostrarConfirmacion = false;
                empleadoSeleccionado = null;

                await CargarEmpleados();

                MostrarMensaje(
                    "Empleado eliminado correctamente.",
                    "alert-success");
            }
            else
            {
                string detalle = await respuesta.Content.ReadAsStringAsync();

                MostrarMensaje(
                    "No se pudo eliminar el empleado. " + detalle,
                    "alert-danger");

                mostrarConfirmacion = false;
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                "Error al eliminar el empleado: " + ex.Message,
                "alert-danger");

            mostrarConfirmacion = false;
        }
        finally
        {
            eliminando = false;
        }
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
        empleadoSeleccionado = null;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
    }

    private void MostrarMensaje(string texto, string clase)
    {
        mensaje = texto;
        claseMensaje = clase;
    }

    private void LimpiarMensaje()
    {
        mensaje = "";
    }

    public class PuestoModel
    {
        public int Id_puesto { get; set; }

        public string Nombre_puesto { get; set; } = string.Empty;

        public string? Descripcion { get; set; }
    }

    public class EmpleadoModel
    {
        public int idempleados { get; set; }

        [Required(ErrorMessage = "El código es obligatorio.")]
        [StringLength(20)]
        public string Codigo { get; set; } = "";

        [Required(ErrorMessage = "Los nombres son obligatorios.")]
        [StringLength(60)]
        public string nombres { get; set; } = "";

        [Required(ErrorMessage = "Los apellidos son obligatorios.")]
        [StringLength(60)]
        public string apellidos { get; set; } = "";

        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [StringLength(100)]
        public string direccion { get; set; } = "";

        [StringLength(45)]
        public string? telefono { get; set; }

        public DateTime? fecha_nacimiento { get; set; }

        [Required(ErrorMessage = "El estado es obligatorio.")]
        [StringLength(20)]
        public string activo { get; set; } = "Activo";

        [Required(ErrorMessage = "La fecha de ingreso es obligatoria.")]
        public DateTime fecha_ingreso { get; set; } = DateTime.Today;

        [Range(1, int.MaxValue,
            ErrorMessage = "Seleccione un puesto.")]
        public int id_puesto { get; set; }

        public decimal? Sueldo { get; set; }

        public decimal? Bonificacion { get; set; }
    }
}
