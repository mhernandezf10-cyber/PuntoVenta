@page "/productos"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Mantenimiento de Productos</PageTitle>

<h3>Mantenimiento de Productos</h3>

<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-header">
            <h5>@(productoActual.Id_producto == 0 ? "Registrar producto" : "Editar producto")</h5>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert @claseMensaje" role="alert">
                    @mensaje
                </div>
            }

            <EditForm Model="@productoActual"
                      OnValidSubmit="@GuardarProducto"
                      FormName="FormularioProductos">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label" for="codigo">Código</label>
                    <InputText id="codigo"
                               class="form-control"
                               @bind-Value="productoActual.Codigo" />
                    <ValidationMessage For="@(() => productoActual.Codigo)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="nombre">Nombre del producto</label>
                    <InputText id="nombre"
                               class="form-control"
                               @bind-Value="productoActual.Nombre" />
                    <ValidationMessage For="@(() => productoActual.Nombre)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="descripcion">Descripción</label>
                    <InputTextArea id="descripcion"
                                   class="form-control"
                                   @bind-Value="productoActual.Descripcion" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="precio">Precio</label>
                    <InputNumber id="precio"
                                 class="form-control"
                                 @bind-Value="productoActual.Precio" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="existencia">Existencia</label>
                    <InputNumber id="existencia"
                                 class="form-control"
                                 @bind-Value="productoActual.Existencia" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="marca">Marca</label>
                    <InputSelect id="marca"
                                 class="form-select"
                                 @bind-Value="productoActual.Id_marca">
                        <option value="">-- Sin marca --</option>
                        @foreach (var marca in marcas)
                        {
                            <option value="@marca.Id_marca">
                                @marca.Nombre
                            </option>
                        }
                    </InputSelect>
                </div>

                <button type="submit" class="btn btn-primary">
                    @(productoActual.Id_producto == 0 ? "Registrar" : "Actualizar")
                </button>

                <button type="button"
                        class="btn btn-secondary ms-2"
                        @onclick="LimpiarFormulario">
                    Limpiar
                </button>
            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5>Productos registrados</h5>
        </div>

        <div class="card-body">
            @if (cargando)
            {
                <p>Cargando productos...</p>
            }
            else if (productos.Count == 0)
            {
                <p>No hay productos registrados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Precio</th>
                                <th>Existencia</th>
                                <th>ID marca</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var producto in productos)
                            {
                                <tr>
                                    <td>@producto.Id_producto</td>
                                    <td>@producto.Codigo</td>
                                    <td>@producto.Nombre</td>
                                    <td>@producto.Descripcion</td>
                                    <td>@producto.Precio.ToString("N2")</td>
                                    <td>@producto.Existencia</td>
                                    <td>@(producto.Id_marca?.ToString() ?? "Sin marca")</td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm"
                                                @onclick="() => EditarProducto(producto)">
                                            Editar
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm ms-1"
                                                @onclick="() => EliminarProducto(producto.Id_producto)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private HttpClient Api => HttpClientFactory.CreateClient("ApiEmpresa");

    private List<ProductoDto> productos = new();
    private List<MarcaDto> marcas = new();

    private ProductoDto productoActual = new();

    private bool cargando = true;
    private string mensaje = string.Empty;
    private string claseMensaje = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        await CargarMarcas();
        await CargarProductos();
    }

    private async Task CargarMarcas()
    {
        try
        {
            marcas = await Api.GetFromJsonAsync<List<MarcaDto>>("api/Marcas")
                     ?? new List<MarcaDto>();
        }
        catch (Exception ex)
        {
            mensaje = "No se pudieron cargar las marcas: " + ex.Message;
            claseMensaje = "alert-danger";
        }
    }

    private async Task CargarProductos()
    {
        cargando = true;

        try
        {
            productos = await Api.GetFromJsonAsync<List<ProductoDto>>("api/Productos")
                         ?? new List<ProductoDto>();
        }
        catch (Exception ex)
        {
            mensaje = "No se pudieron cargar los productos: " + ex.Message;
            claseMensaje = "alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarProducto()
    {
        try
        {
            productoActual.Codigo =
                (productoActual.Codigo ?? string.Empty).Trim();

            productoActual.Nombre =
                (productoActual.Nombre ?? string.Empty).Trim();

            if (string.IsNullOrWhiteSpace(productoActual.Codigo) ||
                string.IsNullOrWhiteSpace(productoActual.Nombre))
            {
                mensaje = "El código y el nombre son obligatorios.";
                claseMensaje = "alert-danger";
                return;
            }

            if (productoActual.Precio < 0 ||
                productoActual.Existencia < 0)
            {
                mensaje = "El precio y la existencia no pueden ser negativos.";
                claseMensaje = "alert-danger";
                return;
            }

            bool esNuevo = productoActual.Id_producto == 0;

            HttpResponseMessage respuesta;

            if (esNuevo)
            {
                respuesta = await Api.PostAsJsonAsync(
                    "api/Productos",
                    productoActual);
            }
            else
            {
                respuesta = await Api.PutAsJsonAsync(
                    $"api/Productos/{productoActual.Id_producto}",
                    productoActual);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                LimpiarFormulario();

                await CargarProductos();

                mensaje = esNuevo
                    ? "El producto se registró correctamente."
                    : "El producto se actualizó correctamente.";

                claseMensaje = "alert-success";
            }
            else
            {
                string detalle =
                    await respuesta.Content.ReadAsStringAsync();

                mensaje = respuesta.StatusCode ==
                          System.Net.HttpStatusCode.Conflict
                    ? "No se pudo guardar. Verifica que el código no esté repetido."
                    : $"Error al guardar el producto: {detalle}";

                claseMensaje = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error al guardar el producto: " + ex.Message;
            claseMensaje = "alert-danger";
        }
    }

    private void EditarProducto(ProductoDto producto)
    {
        productoActual = new ProductoDto
        {
            Id_producto = producto.Id_producto,
            Codigo = producto.Codigo,
            Nombre = producto.Nombre,
            Descripcion = producto.Descripcion,
            Precio = producto.Precio,
            Existencia = producto.Existencia,
            Id_marca = producto.Id_marca
        };

        mensaje = string.Empty;
    }

    private async Task EliminarProducto(int id)
    {
        try
        {
            var respuesta =
                await Api.DeleteAsync($"api/Productos/{id}");

            if (respuesta.IsSuccessStatusCode)
            {
                LimpiarFormulario();

                await CargarProductos();

                mensaje = "El producto se eliminó correctamente.";
                claseMensaje = "alert-success";
            }
            else
            {
                string detalle =
                    await respuesta.Content.ReadAsStringAsync();

                mensaje = respuesta.StatusCode ==
                          System.Net.HttpStatusCode.Conflict
                    ? "No se puede eliminar el producto porque está relacionado con otros registros."
                    : $"Error al eliminar el producto: {detalle}";

                claseMensaje = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error al eliminar el producto: " + ex.Message;
            claseMensaje = "alert-danger";
        }
    }

    private void LimpiarFormulario()
    {
        productoActual = new ProductoDto();
        mensaje = string.Empty;
    }

    public class ProductoDto
    {
        public int Id_producto { get; set; }

        [Required(ErrorMessage = "El código es obligatorio.")]
        [StringLength(30)]
        public string Codigo { get; set; } = string.Empty;

        [Required(ErrorMessage = "El nombre del producto es obligatorio.")]
        [StringLength(100)]
        public string Nombre { get; set; } = string.Empty;

        [StringLength(200)]
        public string? Descripcion { get; set; }

        [Range(typeof(decimal), "0", "999999999",
            ErrorMessage = "El precio no puede ser negativo.")]
        public decimal Precio { get; set; }

        [Range(0, int.MaxValue,
            ErrorMessage = "La existencia no puede ser negativa.")]
        public int Existencia { get; set; }

        public int? Id_marca { get; set; }
    }

    public class MarcaDto
    {
        public int Id_marca { get; set; }

        public string Nombre { get; set; } = string.Empty;
    }
}