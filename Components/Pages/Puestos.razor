
@page "/puestos"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Mantenimiento de Puestos</PageTitle>

<h3>Mantenimiento de Puestos</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NuevoPuesto">
        Nuevo puesto
    </button>

    <a href="/empleado" class="btn btn-secondary ms-2">
        Volver a Empleados
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @claseMensaje" role="alert">
        @mensaje
    </div>
}

<div class="mb-3">
    <label class="form-label">Buscar puesto</label>
    <input class="form-control"
           @bind="busqueda"
           placeholder="Escriba el nombre del puesto" />
</div>

@if (cargando)
{
    <p>Cargando puestos...</p>
}
else if (puestosFiltrados.Count == 0)
{
    <p>No hay puestos para mostrar.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre del puesto</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var puesto in puestosFiltrados)
                {
                    <tr>
                        <td>@puesto.Id_puesto</td>
                        <td>@puesto.Nombre_puesto</td>
                        <td>@puesto.Descripcion</td>
                        <td>
                            <button class="btn btn-warning btn-sm"
                                    @onclick="() => EditarPuesto(puesto)">
                                Editar
                            </button>

                            <button class="btn btn-danger btn-sm ms-1"
                                    @onclick="() => EliminarPuesto(puesto)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarFormulario)
{
    <div class="card mt-4">
        <div class="card-header">
            <strong>@(editando ? "Editar puesto" : "Registrar puesto")</strong>
        </div>

        <div class="card-body">
            <EditForm Model="formulario" OnValidSubmit="GuardarPuesto">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Nombre del puesto</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Nombre_puesto" />
                    <ValidationMessage For="@(() => formulario.Nombre_puesto)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    <InputTextArea class="form-control"
                                   @bind-Value="formulario.Descripcion" />
                </div>

                <button type="submit" class="btn btn-success" disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>

                <button type="button" class="btn btn-secondary ms-2"
                        @onclick="Cancelar">
                    Cancelar
                </button>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly HttpClient Api = null!;

    private List<PuestoModel> puestos = new();
    private PuestoModel formulario = new();

    private string busqueda = "";
    private string mensaje = "";
    private string claseMensaje = "alert-info";

    private bool cargando = true;
    private bool mostrarFormulario;
    private bool editando;
    private bool guardando;

    public Puestos()
    {
    }

    private List<PuestoModel> puestosFiltrados =>
        puestos.Where(p =>
            (p.Nombre_puesto ?? "").Contains(
                busqueda ?? "",
                StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Id_puesto)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
    }

    private HttpClient ObtenerApi()
    {
        return HttpClientFactory.CreateClient("ApiEmpresa");
    }

    private async Task CargarPuestos()
    {
        cargando = true;

        try
        {
            var api = ObtenerApi();
            puestos = await api.GetFromJsonAsync<List<PuestoModel>>("api/Puestos")
                      ?? new List<PuestoModel>();
        }
        catch (Exception ex)
        {
            MostrarMensaje("No se pudieron cargar los puestos: " + ex.Message, false);
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoPuesto()
    {
        formulario = new PuestoModel();
        editando = false;
        mostrarFormulario = true;
        mensaje = "";
    }

    private void EditarPuesto(PuestoModel puesto)
    {
        formulario = new PuestoModel
        {
            Id_puesto = puesto.Id_puesto,
            Nombre_puesto = puesto.Nombre_puesto,
            Descripcion = puesto.Descripcion
        };

        editando = true;
        mostrarFormulario = true;
        mensaje = "";
    }

    private async Task GuardarPuesto()
    {
        if (guardando)
            return;

        guardando = true;
        mensaje = "";

        try
        {
            var api = ObtenerApi();
            HttpResponseMessage respuesta;

            if (editando)
            {
                respuesta = await api.PutAsJsonAsync(
                    $"api/Puestos/{formulario.Id_puesto}", formulario);
            }
            else
            {
                respuesta = await api.PostAsJsonAsync(
                    "api/Puestos", formulario);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                MostrarMensaje(
                    editando ? "Puesto actualizado correctamente."
                             : "Puesto registrado correctamente.",
                    true);

                mostrarFormulario = false;
                await CargarPuestos();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                MostrarMensaje(
                    $"No se pudo guardar el puesto. Código HTTP: {(int)respuesta.StatusCode}. {detalle}",
                    false);
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al guardar el puesto: " + ex.Message, false);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarPuesto(PuestoModel puesto)
    {
        bool confirmar = await JSConfirm(
            $"¿Está seguro de eliminar el puesto '{puesto.Nombre_puesto}'?");

        if (!confirmar)
            return;

        try
        {
            var api = ObtenerApi();
            var respuesta = await api.DeleteAsync($"api/Puestos/{puesto.Id_puesto}");

            if (respuesta.IsSuccessStatusCode)
            {
                MostrarMensaje("Puesto eliminado correctamente.", true);
                await CargarPuestos();
            }
            else if ((int)respuesta.StatusCode == 409)
            {
                MostrarMensaje(
                    "No se puede eliminar este puesto porque está relacionado con empleados.",
                    false);
            }
            else
            {
                MostrarMensaje(
                    $"No se pudo eliminar el puesto. Código HTTP: {(int)respuesta.StatusCode}.",
                    false);
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al eliminar el puesto: " + ex.Message, false);
        }
    }

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private async Task<bool> JSConfirm(string texto)
    {
        return await JS.InvokeAsync<bool>("confirm", texto);
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        formulario = new PuestoModel();
    }

    private void MostrarMensaje(string texto, bool correcto)
    {
        mensaje = texto;
        claseMensaje = correcto ? "alert-success" : "alert-danger";
    }

    public class PuestoModel
    {
        public int Id_puesto { get; set; }

        [Required(ErrorMessage = "Escriba el nombre del puesto.")]
        [StringLength(60, ErrorMessage = "El nombre no puede superar 60 caracteres.")]
        public string Nombre_puesto { get; set; } = "";

        public string? Descripcion { get; set; }
    }
}
