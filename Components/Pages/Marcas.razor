@page "/marcas"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Mantenimiento de Marcas</PageTitle>

<h3>Mantenimiento de Marcas</h3>

<div class="container mt-4">

    <div class="card mb-4">
        <div class="card-header">
            <h5>@(marcaActual.Id_marca == 0 ? "Registrar marca" : "Editar marca")</h5>
        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert @claseMensaje" role="alert">
                    @mensaje
                </div>
            }

            <EditForm Model="@marcaActual"
                      OnValidSubmit="@GuardarMarca"
                      FormName="FormularioMarcas">

                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (marcaActual.Id_marca != 0)
                {
                    <div class="mb-3">
                        <label class="form-label">ID de la marca</label>
                        <input class="form-control"
                               value="@marcaActual.Id_marca"
                               readonly />
                    </div>
                }

                <div class="mb-3">
                    <label for="nombreMarca" class="form-label">
                        Nombre de la marca
                    </label>

                    <InputText id="nombreMarca"
                               class="form-control"
                               @bind-Value="marcaActual.Nombre" />

                    <ValidationMessage For="@(() => marcaActual.Nombre)" />
                </div>

                <div class="mb-3">
                    <label for="descripcionMarca" class="form-label">
                        Descripción
                    </label>

                    <InputTextArea id="descripcionMarca"
                                   class="form-control"
                                   @bind-Value="marcaActual.Descripcion" />

                    <ValidationMessage For="@(() => marcaActual.Descripcion)" />
                </div>

                <button type="submit" class="btn btn-primary">
                    @(marcaActual.Id_marca == 0 ? "Registrar" : "Actualizar")
                </button>

                <button type="button"
                        class="btn btn-secondary ms-2"
                        @onclick="LimpiarFormulario">
                    Limpiar
                </button>

            </EditForm>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5>Marcas registradas</h5>
        </div>

        <div class="card-body">

            @if (cargando)
            {
                <p>Cargando marcas...</p>
            }
            else if (marcas.Count == 0)
            {
                <p>No hay marcas registradas.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripción</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var marca in marcas)
                            {
                                <tr @key="marca.Id_marca">
                                    <td>@marca.Id_marca</td>
                                    <td>@marca.Nombre</td>
                                    <td>@marca.Descripcion</td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-warning btn-sm me-1"
                                                @onclick="() => EditarMarca(marca)">
                                            Editar
                                        </button>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                @onclick="() => EliminarMarca(marca.Id_marca)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private HttpClient Api =>
        HttpClientFactory.CreateClient("ApiEmpresa");

    private List<MarcaDto> marcas = new();

    [SupplyParameterFromForm(FormName = "FormularioMarcas")]
    private MarcaDto marcaActual { get; set; } = default!;

    private bool cargando = true;

    private string mensaje = string.Empty;

    private string claseMensaje = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        marcaActual ??= new MarcaDto();

        await CargarMarcas();
    }

    private async Task CargarMarcas()
    {
        cargando = true;

        try
        {
            marcas = await Api.GetFromJsonAsync<List<MarcaDto>>("api/Marcas")
                     ?? new List<MarcaDto>();

            mensaje = string.Empty;
        }
        catch (Exception ex)
        {
            mensaje = "No se pudieron cargar las marcas. Verifica que ApiEmpresa esté ejecutándose. Detalle: " + ex.Message;
            claseMensaje = "alert-danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task GuardarMarca()
    {
        try
        {
            marcaActual.Nombre = marcaActual.Nombre.Trim();

            if (string.IsNullOrWhiteSpace(marcaActual.Nombre))
            {
                mensaje = "El nombre de la marca es obligatorio.";
                claseMensaje = "alert-danger";
                return;
            }

            HttpResponseMessage respuesta;

            if (marcaActual.Id_marca == 0)
            {
                respuesta = await Api.PostAsJsonAsync(
                    "api/Marcas",
                    marcaActual);
            }
            else
            {
                respuesta = await Api.PutAsJsonAsync(
                    $"api/Marcas/{marcaActual.Id_marca}",
                    marcaActual);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                bool eraRegistro = marcaActual.Id_marca == 0;

                LimpiarFormulario();

                await CargarMarcas();

                mensaje = eraRegistro
                    ? "La marca se registró correctamente."
                    : "La marca se actualizó correctamente.";

                claseMensaje = "alert-success";
            }
            else
            {
                string detalle = await respuesta.Content.ReadAsStringAsync();

                mensaje = respuesta.StatusCode == System.Net.HttpStatusCode.Conflict
                    ? "No se pudo guardar la marca. Es posible que el nombre ya esté registrado."
                    : $"Error al guardar la marca: {detalle}";

                claseMensaje = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error al guardar la marca: " + ex.Message;
            claseMensaje = "alert-danger";
        }
    }

    private void EditarMarca(MarcaDto marca)
    {
        marcaActual = new MarcaDto
        {
            Id_marca = marca.Id_marca,
            Nombre = marca.Nombre,
            Descripcion = marca.Descripcion
        };

        mensaje = string.Empty;
    }

    private async Task EliminarMarca(int id)
    {
        try
        {
            var respuesta = await Api.DeleteAsync($"api/Marcas/{id}");

            if (respuesta.IsSuccessStatusCode)
            {
                await CargarMarcas();

                if (marcaActual.Id_marca == id)
                {
                    LimpiarFormulario();
                }

                mensaje = "La marca se eliminó correctamente.";
                claseMensaje = "alert-success";
            }
            else
            {
                string detalle = await respuesta.Content.ReadAsStringAsync();

                mensaje = $"Error al eliminar la marca: {detalle}";
                claseMensaje = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensaje = "Error al eliminar la marca: " + ex.Message;
            claseMensaje = "alert-danger";
        }
    }

    private void LimpiarFormulario()
    {
        marcaActual = new MarcaDto();
        mensaje = string.Empty;
    }

    public class MarcaDto
    {
        public int Id_marca { get; set; }

        [Required(ErrorMessage = "El nombre de la marca es obligatorio.")]
        [StringLength(60, ErrorMessage = "El nombre no puede superar los 60 caracteres.")]
        public string Nombre { get; set; } = string.Empty;

        [StringLength(150, ErrorMessage = "La descripción no puede superar los 150 caracteres.")]
        public string? Descripcion { get; set; }
    }
}