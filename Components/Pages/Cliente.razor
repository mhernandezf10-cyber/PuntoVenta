@page "/cliente"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Clientes</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h1>Clientes</h1>

        <button class="btn btn-primary"
                @onclick="NuevoCliente">
            Nuevo
        </button>

    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @claseMensaje alert-dismissible fade show">
            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="LimpiarMensaje">
            </button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center mt-4">

            <div class="spinner-border text-primary">
            </div>

            <p class="mt-2">
                Cargando clientes...
            </p>

        </div>
    }
    else
    {
        @if (clientes.Count == 0)
        {
            <div class="alert alert-info">
                No hay clientes registrados.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-striped table-hover table-bordered">

                    <thead class="table-dark">

                        <tr>

                            <th>CUI</th>
                            <th>NIT</th>
                            <th>Nombres</th>
                            <th>Apellidos</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Fecha de nacimiento</th>
                            <th>Acciones</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var cliente in ClientesPagina)
                        {
                            <tr>

                                <td>@cliente.Cui</td>

                                <td>@cliente.NIT</td>

                                <td>@cliente.Nombres</td>

                                <td>@cliente.Apellidos</td>

                                <td>@cliente.Direccion</td>

                                <td>@cliente.Telefono</td>

                                <td>
                                    @cliente.Fecha_nacimiento?.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <button class="btn btn-warning btn-sm me-1"
                                            @onclick="() => EditarCliente(cliente)">
                                        Editar
                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => ConfirmarEliminar(cliente)">
                                        Eliminar
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- PAGINACIÓN -->

            @if (TotalPaginas > 1)
            {
                <nav>

                    <ul class="pagination justify-content-center">

                        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">

                            <button class="page-link"
                                    @onclick="PaginaAnterior">
                                Anterior
                            </button>

                        </li>

                        @for (int i = 1; i <= TotalPaginas; i++)
                        {
                            int pagina = i;

                            <li class="page-item @(paginaActual == pagina ? "active" : "")">

                                <button class="page-link"
                                        @onclick="() => IrPagina(pagina)">
                                    @pagina
                                </button>

                            </li>
                        }

                        <li class="page-item @(paginaActual == TotalPaginas ? "disabled" : "")">

                            <button class="page-link"
                                    @onclick="PaginaSiguiente">
                                Siguiente
                            </button>

                        </li>

                    </ul>

                </nav>
            }
        }
    }

</div>


<!-- ================================================= -->
<!-- MODAL NUEVO / EDITAR -->
<!-- ================================================= -->

@if (mostrarModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        @(modoEdicion ? "Editar Cliente" : "Nuevo Cliente")
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarModal">
                    </button>

                </div>


                <EditForm EditContext="@editContext"
                          OnValidSubmit="GuardarCliente">

                    <DataAnnotationsValidator />


                    <div class="modal-body">

                        <div class="row">


                            <!-- CUI -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    CUI
                                </label>

                                <InputText class="@GetInputClass(nameof(formulario.Cui))"
                                           @bind-Value="formulario.Cui" />

                                <ValidationMessage For="@(() => formulario.Cui)" />

                            </div>


                            <!-- NIT -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    NIT
                                </label>

                                <InputText class="@GetInputClass(nameof(formulario.NIT))"
                                           @bind-Value="formulario.NIT" />

                                <ValidationMessage For="@(() => formulario.NIT)" />

                            </div>


                            <!-- NOMBRES -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Nombres
                                </label>

                                <InputText class="@GetInputClass(nameof(formulario.Nombres))"
                                           @bind-Value="formulario.Nombres" />

                                <ValidationMessage For="@(() => formulario.Nombres)" />

                            </div>


                            <!-- APELLIDOS -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Apellidos
                                </label>

                                <InputText class="@GetInputClass(nameof(formulario.Apellidos))"
                                           @bind-Value="formulario.Apellidos" />

                                <ValidationMessage For="@(() => formulario.Apellidos)" />

                            </div>


                            <!-- DIRECCIÓN -->

                            <div class="col-md-12 mb-3">

                                <label class="form-label">
                                    Dirección
                                </label>

                                <InputTextArea class="@GetInputClass(nameof(formulario.Direccion))"
                                               @bind-Value="formulario.Direccion"
                                               rows="3" />

                                <ValidationMessage For="@(() => formulario.Direccion)" />

                            </div>


                            <!-- TELÉFONO -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Teléfono
                                </label>

                                <InputText class="@GetInputClass(nameof(formulario.Telefono))"
                                           @bind-Value="formulario.Telefono" />

                                <ValidationMessage For="@(() => formulario.Telefono)" />

                            </div>


                            <!-- FECHA -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Fecha de nacimiento
                                </label>

                                <InputDate TValue="DateTime?"
                                           class="@GetInputClass(nameof(formulario.Fecha_nacimiento))"
                                           @bind-Value="formulario.Fecha_nacimiento" />

                                <ValidationMessage For="@(() => formulario.Fecha_nacimiento)" />

                            </div>

                        </div>

                    </div>


                    <!-- BOTONES -->

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CerrarModal">
                            Cancelar
                        </button>


                        @if (modoEdicion)
                        {
                            <button type="submit"
                                    class="btn btn-success">
                                Actualizar
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar
                            </button>
                        }

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}


<!-- ================================================= -->
<!-- MODAL CONFIRMAR ELIMINACIÓN -->
<!-- ================================================= -->

@if (mostrarConfirmacion)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header bg-danger text-white">

                    <h5 class="modal-title">
                        Confirmar eliminación
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CancelarEliminar">
                    </button>

                </div>


                <div class="modal-body">

                    <p>
                        ¿Está seguro que desea eliminar al cliente
                        <strong>
                            @clienteEliminar?.Nombres
                            @clienteEliminar?.Apellidos
                        </strong>?
                    </p>

                    <p class="text-danger">
                        Esta acción no se puede deshacer.
                    </p>

                </div>


                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="CancelarEliminar">
                        No
                    </button>

                    <button class="btn btn-danger"
                            @onclick="EliminarCliente">
                        Sí, eliminar
                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {

    // ============================================
    // HTTP CLIENT
    // ============================================

    private HttpClient Api =>
        HttpClientFactory.CreateClient("ApiEmpresa");


    // ============================================
    // VARIABLES
    // ============================================

    private List<ClienteModel> clientes = new();

    private ClienteModel formulario = new();

    private ClienteModel? clienteEliminar;

    private EditContext editContext = default!;

    private bool cargando = true;

    private bool mostrarModal = false;

    private bool mostrarConfirmacion = false;

    private bool modoEdicion = false;

    private string mensaje = "";

    private string claseMensaje = "alert-info";


    // ============================================
    // PAGINACIÓN
    // ============================================

    private int paginaActual = 1;

    private int registrosPorPagina = 5;

    private int TotalPaginas =>
        clientes.Count == 0
            ? 1
            : (int)Math.Ceiling(
                (double)clientes.Count / registrosPorPagina);


    private IEnumerable<ClienteModel> ClientesPagina =>
        clientes
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina);


    // ============================================
    // INICIO
    // ============================================

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }


    // ============================================
    // GET
    // ============================================

    private async Task CargarClientes()
    {
        try
        {
            cargando = true;

            var resultado =
                await Api.GetFromJsonAsync<List<ClienteModel>>(
                    "api/Clientes");

            clientes = resultado ?? new List<ClienteModel>();

            if (paginaActual > TotalPaginas)
            {
                paginaActual = TotalPaginas;
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                "Error al cargar los clientes: " + ex.Message,
                "alert-danger");
        }
        finally
        {
            cargando = false;
        }
    }


    // ============================================
    // NUEVO
    // ============================================

    private void NuevoCliente()
    {
        formulario = new ClienteModel();

        modoEdicion = false;

        editContext = new EditContext(formulario);

        mostrarModal = true;
    }


    // ============================================
    // EDITAR
    // ============================================

    private void EditarCliente(ClienteModel cliente)
    {
        formulario = new ClienteModel
        {
            Id_clientes = cliente.Id_clientes,
            Cui = cliente.Cui,
            NIT = cliente.NIT,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Fecha_nacimiento = cliente.Fecha_nacimiento
        };

        modoEdicion = true;

        editContext = new EditContext(formulario);

        mostrarModal = true;
    }


    // ============================================
    // POST / PUT
    // ============================================

    private async Task GuardarCliente()
    {
        try
        {
            HttpResponseMessage respuesta;

            if (modoEdicion)
            {
                respuesta = await Api.PutAsJsonAsync(
                    $"api/Clientes/{formulario.Id_clientes}",
                    formulario);
            }
            else
            {
                respuesta = await Api.PostAsJsonAsync(
                    "api/Clientes",
                    formulario);
            }


            if (respuesta.IsSuccessStatusCode)
            {
                bool estabaEditando = modoEdicion;

                CerrarModal();

                await CargarClientes();

                if (!estabaEditando)
                {
                    paginaActual = TotalPaginas;
                }

                MostrarMensaje(
                    estabaEditando
                        ? "Cliente actualizado correctamente."
                        : "Cliente guardado correctamente.",
                    "alert-success");
            }
            else
            {
                var detalle =
                    await respuesta.Content.ReadAsStringAsync();

                MostrarMensaje(
                    "No se pudo guardar el cliente. " + detalle,
                    "alert-danger");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                "Error al guardar: " + ex.Message,
                "alert-danger");
        }
    }


    // ============================================
    // CONFIRMAR ELIMINACIÓN
    // ============================================

    private void ConfirmarEliminar(ClienteModel cliente)
    {
        clienteEliminar = cliente;

        mostrarConfirmacion = true;
    }


    // ============================================
    // CANCELAR ELIMINACIÓN
    // ============================================

    private void CancelarEliminar()
    {
        clienteEliminar = null;

        mostrarConfirmacion = false;
    }


    // ============================================
    // DELETE
    // ============================================

    private async Task EliminarCliente()
    {
        if (clienteEliminar == null)
            return;


        try
        {
            var respuesta =
                await Api.DeleteAsync(
                    $"api/Clientes/{clienteEliminar.Id_clientes}");


            if (respuesta.IsSuccessStatusCode)
            {
                clientes.Remove(clienteEliminar);

                clienteEliminar = null;

                mostrarConfirmacion = false;

                if (paginaActual > TotalPaginas)
                {
                    paginaActual = TotalPaginas;
                }

                MostrarMensaje(
                    "Cliente eliminado correctamente.",
                    "alert-success");
            }
            else
            {
                MostrarMensaje(
                    "No se pudo eliminar el cliente.",
                    "alert-danger");
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                "Error al eliminar: " + ex.Message,
                "alert-danger");
        }
    }


    // ============================================
    // CERRAR MODAL
    // ============================================

    private void CerrarModal()
    {
        mostrarModal = false;

        formulario = new ClienteModel();

        editContext = new EditContext(formulario);
    }


    // ============================================
    // VALIDACIÓN BOOTSTRAP
    // ============================================

    private string GetInputClass(string propertyName)
    {
        if (editContext == null)
            return "form-control";

        var field =
            new FieldIdentifier(formulario, propertyName);

        if (!editContext.IsModified(field))
            return "form-control";

        return editContext.GetValidationMessages(field).Any()
            ? "form-control is-invalid"
            : "form-control is-valid";
    }


    // ============================================
    // MENSAJES
    // ============================================

    private void MostrarMensaje(
        string texto,
        string clase)
    {
        mensaje = texto;

        claseMensaje = clase;
    }


    private void LimpiarMensaje()
    {
        mensaje = "";
    }


    // ============================================
    // PAGINACIÓN
    // ============================================

    private void IrPagina(int pagina)
    {
        if (pagina >= 1 && pagina <= TotalPaginas)
        {
            paginaActual = pagina;
        }
    }


    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
        }
    }


    private void PaginaSiguiente()
    {
        if (paginaActual < TotalPaginas)
        {
            paginaActual++;
        }
    }


    // ============================================
    // MODELO PARA EL FRONT
    // ============================================

    public class ClienteModel
    {
        public int Id_clientes { get; set; }


        [Required(ErrorMessage = "El CUI es obligatorio.")]
        [RegularExpression(
            @"^\d{13}$",
            ErrorMessage = "El CUI debe contener exactamente 13 dígitos.")]
        public string? Cui { get; set; }


        [Required(ErrorMessage = "El NIT es obligatorio.")]
        [RegularExpression(
            @"^[0-9]+(-?[0-9Kk])?$",
            ErrorMessage = "Ingrese un NIT válido.")]
        public string? NIT { get; set; }


        [Required(ErrorMessage = "Los nombres son obligatorios.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage = "Los nombres deben tener entre 2 y 100 caracteres.")]
        [RegularExpression(
            @"^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s'-]+$",
            ErrorMessage = "Los nombres solo pueden contener letras.")]
        public string? Nombres { get; set; }


        [Required(ErrorMessage = "Los apellidos son obligatorios.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage = "Los apellidos deben tener entre 2 y 100 caracteres.")]
        [RegularExpression(
            @"^[a-zA-ZáéíóúÁÉÍÓÚñÑüÜ\s'-]+$",
            ErrorMessage = "Los apellidos solo pueden contener letras.")]
        public string? Apellidos { get; set; }


        [Required(ErrorMessage = "La dirección es obligatoria.")]
        [StringLength(
            250,
            MinimumLength = 5,
            ErrorMessage = "La dirección debe tener entre 5 y 250 caracteres.")]
        public string? Direccion { get; set; }


        [Required(ErrorMessage = "El teléfono es obligatorio.")]
        [RegularExpression(
            @"^\d{8}$",
            ErrorMessage = "El teléfono debe contener exactamente 8 dígitos.")]
        public string? Telefono { get; set; }


        [Required(ErrorMessage = "La fecha de nacimiento es obligatoria.")]
        public DateTime? Fecha_nacimiento { get; set; }
    }
}