
@page "/proveedores"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

<PageTitle>Mantenimiento de Proveedores</PageTitle>

<h3>Mantenimiento de Proveedores</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NuevoProveedor">
        Nuevo proveedor
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @claseMensaje" role="alert">
        @mensaje
    </div>
}

<div class="mb-3">
    <label class="form-label">Buscar proveedor</label>
    <input class="form-control"
           @bind="busqueda"
           placeholder="Buscar por nombre, NIT o teléfono" />
</div>

@if (cargando)
{
    <p>Cargando proveedores...</p>
}
else if (proveedoresFiltrados.Count == 0)
{
    <p>No hay proveedores para mostrar.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>NIT</th>
                    <th>Dirección</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proveedor in proveedoresFiltrados)
                {
                    <tr>
                        <td>@proveedor.Id_proveedor</td>
                        <td>@proveedor.Nombre</td>
                        <td>@proveedor.Nit</td>
                        <td>@proveedor.Direccion</td>
                        <td>@proveedor.Telefono</td>
                        <td>@proveedor.Correo</td>
                        <td>
                            <button class="btn btn-warning btn-sm"
                                    @onclick="() => EditarProveedor(proveedor)">
                                Editar
                            </button>

                            <button class="btn btn-danger btn-sm ms-1"
                                    @onclick="() => EliminarProveedor(proveedor)">
                                Eliminar
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (mostrarFormulario)
{
    <div class="card mt-4 mb-4">
        <div class="card-header">
            <strong>@(editando ? "Editar proveedor" : "Registrar proveedor")</strong>
        </div>

        <div class="card-body">
            <EditForm Model="formulario" OnValidSubmit="GuardarProveedor">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Nombre *</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Nombre" />
                    <ValidationMessage For="@(() => formulario.Nombre)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">NIT</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Nit" />
                    <ValidationMessage For="@(() => formulario.Nit)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Dirección</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Direccion" />
                    <ValidationMessage For="@(() => formulario.Direccion)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Telefono" />
                    <ValidationMessage For="@(() => formulario.Telefono)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <InputText class="form-control"
                               @bind-Value="formulario.Correo" />
                    <ValidationMessage For="@(() => formulario.Correo)" />
                </div>

                <button type="submit" class="btn btn-success"
                        disabled="@guardando">
                    @(guardando ? "Guardando..." : "Guardar")
                </button>

                <button type="button" class="btn btn-secondary ms-2"
                        @onclick="Cancelar">
                    Cancelar
                </button>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<ProveedorModel> proveedores = new();
    private ProveedorModel formulario = new();

    private string busqueda = "";
    private string mensaje = "";
    private string claseMensaje = "alert-info";

    private bool cargando = true;
    private bool mostrarFormulario;
    private bool editando;
    private bool guardando;

    private HttpClient Api =>
        HttpClientFactory.CreateClient("ApiEmpresa");

    private List<ProveedorModel> proveedoresFiltrados =>
        proveedores.Where(p =>
            (p.Nombre ?? "").Contains(
                busqueda ?? "",
                StringComparison.OrdinalIgnoreCase)
            || (p.Nit ?? "").Contains(
                busqueda ?? "",
                StringComparison.OrdinalIgnoreCase)
            || (p.Telefono ?? "").Contains(
                busqueda ?? "",
                StringComparison.OrdinalIgnoreCase))
            .OrderBy(p => p.Id_proveedor)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedores();
    }

    private async Task CargarProveedores()
    {
        cargando = true;

        try
        {
            proveedores = await Api.GetFromJsonAsync<List<ProveedorModel>>(
                "api/Proveedores") ?? new List<ProveedorModel>();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                "No se pudieron cargar los proveedores: " + ex.Message,
                false);
        }
        finally
        {
            cargando = false;
        }
    }

    private void NuevoProveedor()
    {
        formulario = new ProveedorModel();
        editando = false;
        mostrarFormulario = true;
        mensaje = "";
    }

    private void EditarProveedor(ProveedorModel proveedor)
    {
        formulario = new ProveedorModel
        {
            Id_proveedor = proveedor.Id_proveedor,
            Nombre = proveedor.Nombre,
            Nit = proveedor.Nit,
            Direccion = proveedor.Direccion,
            Telefono = proveedor.Telefono,
            Correo = proveedor.Correo
        };

        editando = true;
        mostrarFormulario = true;
        mensaje = "";
    }

    private async Task GuardarProveedor()
    {
        if (guardando)
            return;

        guardando = true;
        mensaje = "";

        try
        {
            HttpResponseMessage respuesta;

            if (editando)
            {
                respuesta = await Api.PutAsJsonAsync(
                    $"api/Proveedores/{formulario.Id_proveedor}",
                    formulario);
            }
            else
            {
                respuesta = await Api.PostAsJsonAsync(
                    "api/Proveedores",
                    formulario);
            }

            if (respuesta.IsSuccessStatusCode)
            {
                MostrarMensaje(
                    editando
                        ? "Proveedor actualizado correctamente."
                        : "Proveedor registrado correctamente.",
                    true);

                mostrarFormulario = false;
                await CargarProveedores();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();

                MostrarMensaje(
                    $"No se pudo guardar el proveedor. Código HTTP: {(int)respuesta.StatusCode}. {detalle}",
                    false);
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al guardar el proveedor: " + ex.Message, false);
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarProveedor(ProveedorModel proveedor)
    {
        bool confirmar = await JS.InvokeAsync<bool>(
            "confirm",
            $"¿Está seguro de eliminar al proveedor '{proveedor.Nombre}'?");

        if (!confirmar)
            return;

        try
        {
            var respuesta = await Api.DeleteAsync(
                $"api/Proveedores/{proveedor.Id_proveedor}");

            if (respuesta.IsSuccessStatusCode)
            {
                MostrarMensaje("Proveedor eliminado correctamente.", true);
                await CargarProveedores();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();

                MostrarMensaje(
                    $"No se pudo eliminar el proveedor. Código HTTP: {(int)respuesta.StatusCode}. {detalle}",
                    false);
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje("Error al eliminar el proveedor: " + ex.Message, false);
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        formulario = new ProveedorModel();
    }

    private void MostrarMensaje(string texto, bool correcto)
    {
        mensaje = texto;
        claseMensaje = correcto ? "alert-success" : "alert-danger";
    }

    public class ProveedorModel
    {
        public int Id_proveedor { get; set; }

        [Required(ErrorMessage = "El nombre del proveedor es obligatorio.")]
        [StringLength(100, ErrorMessage = "El nombre no puede superar 100 caracteres.")]
        public string Nombre { get; set; } = "";

        [StringLength(20, ErrorMessage = "El NIT no puede superar 20 caracteres.")]
        public string? Nit { get; set; }

        [StringLength(150, ErrorMessage = "La dirección no puede superar 150 caracteres.")]
        public string? Direccion { get; set; }

        [StringLength(20, ErrorMessage = "El teléfono no puede superar 20 caracteres.")]
        public string? Telefono { get; set; }

        [StringLength(100, ErrorMessage = "El correo no puede superar 100 caracteres.")]
        [EmailAddress(ErrorMessage = "Ingrese un correo electrónico válido.")]
        public string? Correo { get; set; }
    }
}
