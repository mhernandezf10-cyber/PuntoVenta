
@page "/inventario"
@rendermode InteractiveServer

@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.Linq

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Inventario</PageTitle>

<h3>Control de Inventario</h3>

<div class="card p-3 mb-3">
    <label class="form-label">Buscar producto</label>

    <input class="form-control"
           placeholder="Buscar por código o nombre"
           @bind="busqueda"
           @bind:event="oninput" />

    <button type="button"
            class="btn btn-primary mt-3"
            disabled="@cargando"
            @onclick="CargarInventario">
        @(cargando ? "Cargando inventario..." : "Recargar inventario")
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-info")">
        @mensaje
    </div>
}

@if (cargando)
{
    <p>Cargando inventario...</p>
}
else
{
    <div class="row mb-3">
        <div class="col-md-4 mb-2">
            <div class="card p-3">
                <h6>Productos registrados</h6>
                <h4>@productos.Count</h4>
            </div>
        </div>

        <div class="col-md-4 mb-2">
            <div class="card p-3">
                <h6>Unidades disponibles</h6>
                <h4>@productos.Sum(p => p.Existencia)</h4>
            </div>
        </div>

        <div class="col-md-4 mb-2">
            <div class="card p-3">
                <h6>Productos agotados</h6>
                <h4>@productos.Count(p => p.Existencia <= 0)</h4>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Descripción</th>
                    <th>Existencia</th>
                    <th>Precio unitario</th>
                    <th>Estado</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var producto in productosFiltrados)
                {
                    <tr @key="producto.Id_producto">
                        <td>@producto.Id_producto</td>
                        <td>@producto.Codigo</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.Descripcion</td>
                        <td>@producto.Existencia</td>
                        <td>Q @producto.Precio.ToString("N2")</td>
                        <td>
                            @if (producto.Existencia <= 0)
                            {
                                <span class="badge bg-danger">Agotado</span>
                            }
                            else if (producto.Existencia <= 5)
                            {
                                <span class="badge bg-warning text-dark">
                                    Existencia baja
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                        </td>
                    </tr>
                }

                @if (productosFiltrados.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No se encontraron productos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly JsonSerializerOptions opcionesJson =
        new()
        {
            PropertyNameCaseInsensitive = true
        };

    private List<ProductoInventario> productos = new();

    private string busqueda = "";
    private string mensaje = "";

    private bool esError;
    private bool cargando;

    private List<ProductoInventario> productosFiltrados =>
        productos
            .Where(p =>
                (p.Nombre ?? "").Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase)
                ||
                (p.Codigo ?? "").Contains(
                    busqueda,
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarInventario();
    }

    private async Task CargarInventario()
    {
        if (cargando)
            return;

        cargando = true;
        mensaje = "";
        esError = false;

        try
        {
            var api = HttpClientFactory.CreateClient("ApiEmpresa");

            using var respuesta = await api.GetAsync("api/Productos");

            if (!respuesta.IsSuccessStatusCode)
            {
                mensaje =
                    $"Error al consultar productos. Código HTTP: {(int)respuesta.StatusCode}.";

                esError = true;
                return;
            }

            var contenido =
                await respuesta.Content.ReadAsStringAsync();

            var lista =
                JsonSerializer.Deserialize<List<ProductoInventario>>(
                    contenido,
                    opcionesJson);

            productos = lista ?? new List<ProductoInventario>();

            mensaje =
                $"Inventario actualizado. Productos encontrados: {productos.Count}.";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar el inventario: {ex.Message}";
            esError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    public class ProductoInventario
    {
        public int Id_producto { get; set; }

        public string Codigo { get; set; } = "";

        public string Nombre { get; set; } = "";

        public string? Descripcion { get; set; }

        public decimal Precio { get; set; }

        public int Existencia { get; set; }
    }
}
